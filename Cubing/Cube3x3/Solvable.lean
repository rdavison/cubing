module
public import Cubing.Cube3x3.Generate
public import Mathlib.GroupTheory.Perm.Closure
public import Mathlib.GroupTheory.Perm.Cycle.Concrete

set_option doc.verso true

/-!
This chapter proves the converse of the invariants chapter: every valid state can be reached.
The proof applies the generation lemma twice, once to corners and once to edges. It needs only
a handful of standard algorithms. Each is checked by evaluating it
on all twenty pieces.
-/

@[expose] public section

namespace Cubing.Cube3x3

open Equiv SemidirectProduct OPerm

/-!
# The algorithms

The T-perm swaps two corners and two edges. Two short sequences cycle all eight corners and all
twelve edges respectively. The A-perm and the U-perm are pure 3-cycles of corners and of edges.
A sequence built on the sledgehammer twists two corners, and a fourteen-move sequence flips two edges.
-/

/-- The T-perm swaps corners URF and UBR, and edges UR and UL. -/
theorem tPerm_fst : (cube[R U R' U' R' F R2 U' R' U' R U R' F']).1.right = swap .URF .UBR := by
  refine Equiv.ext fun c => ?_; cases c <;> rfl

/-- The T-perm swaps edges UR and UL. -/
theorem tPerm_snd : (cube[R U R' U' R' F R2 U' R' U' R U R' F']).2.right = swap .UR .UL := by
  refine Equiv.ext fun c => ?_; cases c <;> rfl

/-- The corner 8-cycle, as a list in the order the pieces travel. -/
def cornerCycle : List Corner := [.URF, .DBL, .DFR, .UFL, .DLF, .DRB, .ULB, .UBR]

/-- The edge 12-cycle, as a list in the order the pieces travel. -/
def edgeCycle : List Edge := [.UR, .FL, .DL, .DF, .DR, .FR, .UF, .UB, .BR, .DB, .BL, .UL]

/-- {lit}`U D2 L2` moves all eight corners round a single cycle. -/
theorem cycle8 : (cube[U D2 L2]).1.right = cornerCycle.formPerm := by
  refine Equiv.ext fun c => ?_; cases c <;> rfl

/-- {lit}`U R U D L` moves all twelve edges round a single cycle. -/
theorem cycle12 : (cube[U R U D L]).2.right = edgeCycle.formPerm := by
  refine Equiv.ext fun c => ?_; cases c <;> rfl

/-- The A-perm cycles three corners and leaves every edge in place. -/
theorem aPerm : cube[R' F R' B2 R F' R' B2 R2] =
    (inr (swap .URF .UBR * swap .URF .ULB), 1) := by
  cube_eq

/-- The U-perm cycles three edges and leaves every corner in place. -/
theorem uPerm : cube[R U' R U R U R U' R' U' R2] =
    (1, inr (swap .UR .UF * swap .UR .UL)) := by
  cube_eq

set_option maxRecDepth 4096 in
/-- Repeated sledgehammers twist corner UBR forward and corner URF back. -/
theorem twoCornerTwist : cube[R' D' R D R' D' R D U R' D' R D R' D' R D R' D' R D R' D' R D U'] =
    (inl (pairTwist .UBR .URF), 1) := by
  cube_eq

/-- A fourteen-move sequence flips edges UF and UL. -/
theorem twoEdgeFlip : cube[F R B L U L' U B' R' F' L' U' L U'] = (1, inl (pairTwist .UF .UL)) := by
  cube_eq

/-!
# Every permutation is a set-up

The 8-cycle and a swap of two neighbours on it generate every permutation of the corners. This
is {name}`Equiv.Perm.closure_cycle_adjacent_swap`. The same holds for edges.
-/

/-- Every permutation of a type is generated by a full cycle and a swap of neighbours on it, so
it is realised by the subgroup containing both. -/
private theorem surj_of_cycle {β : Type} [Fintype β] [DecidableEq β] (H : Subgroup (Perm β))
    (l : List β) (hl : l.Nodup) (hlen : 2 ≤ l.length) (huniv : l.toFinset = Finset.univ)
    (hσ : l.formPerm ∈ H) (x : β) (hs : swap x (l.formPerm x) ∈ H) : H = ⊤ := by
  have hsupp : l.formPerm.support = Finset.univ := by
    rw [List.support_formPerm_of_nodup l hl, huniv]
    rintro y rfl
    simp at hlen
  rw [eq_top_iff, ← Perm.closure_cycle_adjacent_swap (List.isCycle_formPerm hl hlen) hsupp x,
    Subgroup.closure_le]
  rintro τ (rfl | rfl)
  exacts [hσ, hs]

/-- The corner parts of reachable states. -/
def cornerSetUps : Subgroup CornerGroup := reachable.map (MonoidHom.fst _ _)

/-- The edge parts of reachable states. -/
def edgeSetUps : Subgroup EdgeGroup := reachable.map (MonoidHom.snd _ _)

/-- The corner permutation of any move sequence is realised by the set-ups. -/
theorem alg_fst_right_mem (ms : List Move) : (alg ms).1.right ∈ cornerSetUps.map rightHom :=
  ⟨(alg ms).1, ⟨alg ms, alg_mem_reachable ms, rfl⟩, rfl⟩

/-- The edge permutation of any move sequence is realised by the set-ups. -/
theorem alg_snd_right_mem (ms : List Move) : (alg ms).2.right ∈ edgeSetUps.map rightHom :=
  ⟨(alg ms).2, ⟨alg ms, alg_mem_reachable ms, rfl⟩, rfl⟩

/-- Reachable states move the corners in every possible way. -/
theorem cornerSetUps_surj (σ : Perm Corner) : ∃ l ∈ cornerSetUps, l.right = σ := by
  have htop : cornerSetUps.map rightHom = ⊤ := by
    refine surj_of_cycle _ cornerCycle (by decide) (by decide) (by decide) ?_ .UBR ?_
    · rw [← cycle8]
      exact alg_fst_right_mem _
    · rw [show cornerCycle.formPerm .UBR = .URF by rfl, swap_comm, ← tPerm_fst]
      exact alg_fst_right_mem _
  obtain ⟨l, hl, h⟩ := htop ▸ Subgroup.mem_top σ
  exact ⟨l, hl, h⟩

/-- Reachable states move the edges in every possible way. -/
theorem edgeSetUps_surj (σ : Perm Edge) : ∃ l ∈ edgeSetUps, l.right = σ := by
  have htop : edgeSetUps.map rightHom = ⊤ := by
    refine surj_of_cycle _ edgeCycle (by decide) (by decide) (by decide) ?_ .UL ?_
    · rw [← cycle12]
      exact alg_snd_right_mem _
    · rw [show edgeCycle.formPerm .UL = .UR by rfl, swap_comm, ← tPerm_snd]
      exact alg_snd_right_mem _
  obtain ⟨l, hl, h⟩ := htop ▸ Subgroup.mem_top σ
  exact ⟨l, hl, h⟩

/-!
# Pure corner states and pure edge states

The reachable states that leave every edge alone form a subgroup of corner states. Conjugating
one by any reachable state leaves the edges alone again. So the set-up moves are the corner parts
of all reachable states. The same goes for edges.
-/

/-- Reachable states that leave every edge alone, as corner states. -/
def pureCorners : Subgroup CornerGroup := reachable.comap (MonoidHom.inl _ _)

/-- Reachable states that leave every corner alone, as edge states. -/
def pureEdges : Subgroup EdgeGroup := reachable.comap (MonoidHom.inr _ _)

/-- Reachable states set up pure corner states. -/
theorem setUp_corners : SetUp pureCorners cornerSetUps where
  conj_mem := by
    rintro _ ⟨g, hg, rfl⟩ _ hk
    have := reachable.mul_mem (reachable.mul_mem hg hk) (reachable.inv_mem hg)
    change (_, _) ∈ reachable
    convert this using 1
    ext <;> simp
  surj := cornerSetUps_surj

/-- Reachable states set up pure edge states. -/
theorem setUp_edges : SetUp pureEdges edgeSetUps where
  conj_mem := by
    rintro _ ⟨g, hg, rfl⟩ _ hk
    have := reachable.mul_mem (reachable.mul_mem hg hk) (reachable.inv_mem hg)
    change (_, _) ∈ reachable
    convert this using 1
    ext <;> simp
  surj := edgeSetUps_surj

/-- Pure corner states are valid, so their twists total zero. -/
theorem pureCorners_le : pureCorners ≤ twistSum.ker := fun _ hk =>
  ((mem_valid _).mp (reachable_le_valid hk)).2.1

/-- Pure edge states are valid, so their flips total zero. -/
theorem pureEdges_le : pureEdges ≤ twistSum.ker := fun _ hk =>
  ((mem_valid _).mp (reachable_le_valid hk)).2.2

/-- Every corner state with even permutation and total twist zero is a pure corner state. -/
theorem corners_le : twistSum.ker ⊓ (alternatingGroup Corner).comap rightHom ≤ pureCorners := by
  refine setUp_corners.le pureCorners_le (k := inr (swap .URF .UBR * swap .URF .ULB)) ?_ ?_
    (i₀ := .UBR) (j₀ := .URF) (by decide) ?_
  · change (_, _) ∈ reachable
    rw [← aPerm]
    exact alg_mem_reachable _
  · exact Perm.isThreeCycle_swap_mul_swap_same (by decide) (by decide) (by decide)
  · change (_, _) ∈ reachable
    rw [← twoCornerTwist]
    exact alg_mem_reachable _

/-- Every edge state with even permutation and total flip zero is a pure edge state. -/
theorem edges_le : twistSum.ker ⊓ (alternatingGroup Edge).comap rightHom ≤ pureEdges := by
  refine setUp_edges.le pureEdges_le (k := inr (swap .UR .UF * swap .UR .UL)) ?_ ?_
    (i₀ := .UF) (j₀ := .UL) (by decide) ?_
  · change (_, _) ∈ reachable
    rw [← uPerm]
    exact alg_mem_reachable _
  · exact Perm.isThreeCycle_swap_mul_swap_same (by decide) (by decide) (by decide)
  · change (_, _) ∈ reachable
    rw [← twoEdgeFlip]
    exact alg_mem_reachable _

/-!
# Every valid state is reachable

A valid state with odd permutations becomes one with even permutations after a single quarter
turn. Its corner part and its edge part are then separately reachable, and the state is their
product.
-/

/-- A valid state whose permutations are even is reachable. -/
private theorem even_mem (v : Cube) (hv : v ∈ valid) (heven : parity v.1 = 1) : v ∈ reachable := by
  obtain ⟨hpar, htw, hfl⟩ := (mem_valid v).mp hv
  have hc : v.1 ∈ pureCorners :=
    corners_le ⟨htw, Perm.mem_alternatingGroup.mpr heven⟩
  have he : v.2 ∈ pureEdges :=
    edges_le ⟨hfl, Perm.mem_alternatingGroup.mpr (hpar ▸ heven)⟩
  have := reachable.mul_mem hc he
  convert this using 1
  ext <;> simp

/-- Every valid state is reachable. -/
theorem valid_le_reachable : valid ≤ reachable := by
  intro v hv
  obtain h | h := Int.units_eq_one_or (parity v.1)
  · exact even_mem v hv h
  · have hU : v * move .U ∈ valid := valid.mul_mem hv (move_mem_valid .U)
    have heven : parity (v * move .U).1 = 1 := by
      rw [Prod.fst_mul, map_mul, h, parity_move_fst]
      rfl
    have := reachable.mul_mem (even_mem _ hU heven) (reachable.inv_mem (move_mem_reachable .U))
    simpa using this

/-!
# The theorem

The reachable states are exactly the valid states. In particular they can be counted.
-/

/-- **The fundamental theorem of the cube.** A state is reachable by turning faces exactly when
its parities agree, its corner twists total zero, and its edge flips total zero. -/
theorem reachable_eq_valid : reachable = valid :=
  le_antisymm reachable_le_valid valid_le_reachable

/-- The number of reachable cube states. -/
theorem card_reachable : Nat.card reachable = 43252003274489856000 := by
  rw [reachable_eq_valid, card_valid]

end Cubing.Cube3x3
